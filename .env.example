# Telegram
BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=123456789
TIMEZONE=Asia/Almaty

# LLM
# Primary project. Keep the old variable for backwards compatibility.
GEMINI_API_KEY=your_primary_gemini_api_key
# Optional backup projects. Use separate Google projects/accounts only as reliability failover.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Alternative: comma-separated backup pool (duplicates are ignored)
# GEMINI_API_KEYS=key_a,key_b,key_c
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=35
JARVIS_PROFILE_FILE=profile.local.md

# Redis: short-term chat context + Windows PC agent queue
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rotated_upstash_token
PC_AGENT_SECRET=generate_a_long_random_secret_for_bot_and_windows_agent

# Database
DATABASE_URL=sqlite+aiosqlite:///jarvis.db
# Production strongly recommended on Render:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/jarvis

# Schedule
ENABLE_MASTER_SCHEDULE=true

# Moodle/LMS
# Personal Moodle calendar export URL. Treat it like a password; never commit it.
LMS_ICAL_URL=
LMS_SYNC_MINUTES=15

# Mini App / HTTP server
# Must be public HTTPS when opened from Telegram, e.g. https://jarvis.example.com
WEBAPP_URL=
HOST=0.0.0.0
PORT=8080
MINIAPP_AUTH_MAX_AGE=86400
# Local browser testing only. NEVER enable in production.
MINIAPP_DEV_MODE=false

LOG_LEVEL=INFO
