# Telegram
BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=123456789
TIMEZONE=Asia/Almaty

# LLM
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
JARVIS_PROFILE_FILE=profile.local.md

# Redis: short-term chat context + Windows PC agent queue
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rotated_upstash_token
PC_AGENT_SECRET=generate_a_long_random_secret_for_bot_and_windows_agent

# Database
DATABASE_URL=sqlite+aiosqlite:///jarvis.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/jarvis

# Schedule
ENABLE_MASTER_SCHEDULE=true

# Mini App / HTTP server
# Must be public HTTPS when opened from Telegram, e.g. https://jarvis.example.com
WEBAPP_URL=
HOST=0.0.0.0
PORT=8080
MINIAPP_AUTH_MAX_AGE=86400
# Local browser testing only. NEVER enable in production.
MINIAPP_DEV_MODE=false

LOG_LEVEL=INFO
