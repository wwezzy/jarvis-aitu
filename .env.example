# Telegram
BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=123456789
TIMEZONE=Asia/Almaty

# OpenAI (primary)
OPENAI_API_KEY=your_openai_api_key
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_PLANNER_MODEL=gpt-5.6-terra
OPENAI_PREMIUM_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low

# NVIDIA NIM (optional second provider)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Gemini (optional emergency fallback pool)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

LLM_TIMEOUT_SECONDS=35
JARVIS_PROFILE_FILE=profile.local.md

# Redis: short-term chat context + Windows PC agent queue
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PC_AGENT_SECRET=

# Database
# Production/staging on Render should use PostgreSQL, not local SQLite.
DATABASE_URL=sqlite+aiosqlite:///jarvis.db

# Schedule
ENABLE_MASTER_SCHEDULE=true

# Moodle/LMS
LMS_ICAL_URL=
LMS_SYNC_MINUTES=15

# Mini App / HTTP server
WEBAPP_URL=
HOST=0.0.0.0
PORT=8080
MINIAPP_AUTH_MAX_AGE=86400
MINIAPP_DEV_MODE=false

LOG_LEVEL=INFO
